[", "_x_x_x_x_bach_float64_x_x_x_x_", 2532929430, 1086095727, "[", "_x_x_x_x_bach_float64_x_x_x_x_", 0, 1086045184, "_x_x_x_x_bach_float64_x_x_x_x_", 0, 1079574528, 100, 0, "]", 0, "]", "[", "_x_x_x_x_bach_float64_x_x_x_x_", 2532929430, 1086121327, "[", "_x_x_x_x_bach_float64_x_x_x_x_", 0, 1086051584, "_x_x_x_x_bach_float64_x_x_x_x_", 0, 1079574528, 100, 0, "]", 0, "]", "[", "_x_x_x_x_bach_float64_x_x_x_x_", 2532929430, 1086146927, "[", "_x_x_x_x_bach_float64_x_x_x_x_", 0, 1086057984, "_x_x_x_x_bach_float64_x_x_x_x_", 0, 1079574528, 100, 0, "]", 0, "]", "[", "_x_x_x_x_bach_float64_x_x_x_x_", 2532929430, 1086172527, "[", "_x_x_x_x_bach_float64_x_x_x_x_", 0, 1086064384, "_x_x_x_x_bach_float64_x_x_x_x_", 0, 1079574528, 100, 0, "]", 0, "]", "[", "_x_x_x_x_bach_float64_x_x_x_x_", 2532929430, 1086198127, "[", "_x_x_x_x_bach_float64_x_x_x_x_", 0, 1086070784, "_x_x_x_x_bach_float64_x_x_x_x_", 0, 1079574528, 100, 0, "]", 0, "]", 0, "]" ],
                    "whole_roll_data_count": [ 3 ],
